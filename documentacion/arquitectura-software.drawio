ry"/></mxCell><mxCell id="ocr" value="&lt;b&gt;OCR de tickets&lt;/b&gt;&lt;br&gt;ML Kit texto (latino, en el telefono)&lt;br&gt;TicketTextRecognizer" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="220" height="80" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;Repositorios (implementacion)&lt;/b&gt;&lt;br&gt;Product, Store, MonthlyList, Price, TicketImport, ExcelExport, Sync" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="560" width="220" height="80" as="geometry"/></mxCell><mxCell id="xls" value="&lt;b&gt;Exportacion Excel&lt;/b&gt;&lt;br&gt;ExcelExporter con poi-android (.xlsx)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="870" y="560" width="220" height="80" as="geometry"/></mxCell><mxCell id="room" value="&lt;b&gt;Room (SQLite, v2)&lt;/b&gt;&lt;br&gt;AppDatabase + 7 DAOs&lt;br&gt;Base de datos principal, funciona sin internet" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="690" width="220" height="80" as="geometry"/></mxCell><mxCell id="sync" value="&lt;b&gt;Sincronizacion opcional&lt;/b&gt;&lt;br&gt;SyncScheduler, WorkManager, SyncWorker, SyncRepositoryImpl, FirestoreDataSource" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="220" height="80" as="geometry"/></mxCell><mxCell id="fire" value="&lt;b&gt;Firebase&lt;/b&gt;&lt;br&gt;Auth anonima + Firestore&lt;br&gt;users/{uid}/products, stores, monthlyLists, priceRecords" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontSize=1